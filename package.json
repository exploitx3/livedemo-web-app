{
  "name": "livedemo-web-app",
  "version": "0.1.0",
  "description": "LiveDemo Editor - app.livedemo.ai",
  "author": "George Apostolov",
  "license": "MIT",
  "engines": {
    "node": ">=8",
    "npm": ">=3"
  },
  "type": "module",
  "sideEffects": [
    "node_modules/use-sync-external-store/**/*"
  ],
  "scripts": {
    "start-message": "npx babel-node tools/startMessage.js",
    "config-env": "node configEnv.js",
    "prestart": "npm run start-message",
    "start-webpack": "ENV=dev && npm run config-env && concurrently -k -r -s first \"npm run open:src\" ",
    "start": "nodemon --watch ../livedemo-components/georgi.apostolov-livedemo-components-1.0.3.tgz --exec 'vite serve --port 5000'",
    "start-vite-docker": "node configEnv.js && vite serve --port 5000",
    "start-vite": ". ./dev.env && node configEnv.js && vite serve --port 5000",
    "start-vite-preview": ". ./dev.env && node configEnv.js && vite preview --port 5000",
    "start-vite-old": "nodemon --watch ../livedemo-components/georgi.apostolov-livedemo-components-1.0.3.tgz --exec 'vite serve --port 5000'",
    "start-prod": "ENV=prod && npm run config-env && concurrently -k -r -s first \"npm run open:src\" ",
    "start-orig": "concurrently -k -r -s first \"npm run test:watch\" \"npm run open:src\" \"npm run lint:watch\"",
    "open:src": "npx babel-node tools/srcServer.js",
    "open-prod:src": "ENV=prod npx babel-node tools/srcServer.js",
    "open:dist": "npx babel-node tools/distServer.js",
    "lint": "esw webpack.config.* src tools --color",
    "lint:watch": "npm run lint -- --watch",
    "clean-dist": "npm run remove-dist && mkdir dist",
    "remove-dist": "rimraf ./dist",
    "prebuild": "npm run clean-dist && npm run config-env",
    "build": "npx babel-node tools/build.js && npm run open:dist",
    "build-vite": "vite build",
    "build-prod": "ENV=prod && npm run config-env && npx babel-node --max_old_space_size=8000 tools/build.js",
    "build-staging": "ENV=staging npm run config-env && npx babel-node --max_old_space_size=8000 tools/build.js",
    "serve": "npm run open:dist",
    "serve-webpack": "npm run open:dist",
    "test": "jest",
    "test:CI": "jest",
    "test:cover": "npm run test -- --coverage ",
    "test:cover:CI": "npm run test:CI -- --coverage && cat ./coverage/lcov.info | node_modules/coveralls/bin/coveralls.js",
    "test:watch": "jest --watchAll",
    "open:cover": "npm run test:cover && opn ./coverage/lcov-report/index.html",
    "analyze-bundle": "npx babel-node ./tools/analyzeBundle.js",
    "bundle-inject": "npx webpack-dev-server --config webpack.inject.config.js --progress --mode=development",
    "bundle": "node configEnv.js && npx webpack --progress --mode=production --config webpack.inject.prod.config.js"
  },
  "dependencies": {
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "7.28.5",
    "@emoji-mart/react": "1.1.1",
    "@emotion/css": "11.9.0",
    "@floating-ui/dom": "1.7.4",
    "@fontsource/lexend": "4.5.12",
    "@fontsource/roboto-mono": "5.2.9",
    "@hello-pangea/dnd": "18.0.1",
    "@popperjs/core": "^2.11.6",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-inject": "5.0.5",
    "@rollup/plugin-replace": "6.0.3",
    "@stripe/react-stripe-js": "5.4.1",
    "@stripe/stripe-js": "8.6.1",
    "@tippyjs/react": "^4.2.6",
    "@vitejs/plugin-legacy": "4.1.1",
    "@vitejs/plugin-react": "5.1.2",
    "@vitejs/plugin-react-refresh": "1.3.6",
    "antd": "6.2.0",
    "axios": "1.13.6",
    "babel-loader": "9.1.3",
    "babel-plugin-import": "1.13.8",
    "babel-plugin-transform-imports": "2.0.0",
    "babel-plugin-transform-react-remove-prop-types": "0.4.24",
    "buffer": "5.6.0",
    "chrome-browser-object-polyfill": "0.2.2",
    "codemirror": "5.65.2",
    "get-blob-duration": "1.1.2",
    "hls": "0.0.1",
    "hls.js": "^1.2.3",
    "html2canvas": "1.4.1",
    "image-extensions": "1.1.0",
    "immer": "10.0.1",
    "is-hotkey": "0.2.0",
    "is-url": "1.2.4",
    "jest": "30.3.0",
    "lodash": "4.17.23",
    "moment": "2.30.1",
    "moment-timezone": "0.5.48",
    "parse5": "8.0.0",
    "payment-icons": "1.2.1",
    "query-string": "6.8.3",
    "rc-progress": "3.5.1",
    "re-resizable": "6.11.2",
    "react": "^18.3.1",
    "react-colorful": "5.5.1",
    "react-confetti": "6.4.0",
    "react-device-detect": "2.2.3",
    "react-dom": "^18.3.1",
    "react-google-recaptcha": "^2.1.0",
    "react-hot-toast": "2.4.0",
    "react-icons": "5.0.1",
    "react-joyride": "2.9.3",
    "react-media": "1.10.0",
    "react-recaptcha": "2.3.10",
    "react-redux": "^8.1.3",
    "react-router-dom": "6.30.3",
    "react-spinners": "0.17.0",
    "react-toastify": "11.0.5",
    "react-top-loading-bar": "2.3.1",
    "react-transition-group": "4.2.2",
    "recharts": "2.15.4",
    "redux": "^4.2.1",
    "redux-thunk": "2.3.0",
    "rrweb": "2.0.0-alpha.3",
    "rrweb-player": "0.7.14",
    "sass": "1.97.2",
    "secure-ls": "2.0.0",
    "short-uuid": "6.0.3",
    "simmerjs": "0.5.6",
    "slate": "0.93.0",
    "slate-history": "0.66.0",
    "slate-hyperscript": "0.77.0",
    "slate-react": "0.93.0",
    "snapsvg-cjs": "0.0.6",
    "styled-components": "6.3.8",
    "three": "0.183.2",
    "tippy.js": "6.3.7",
    "toastr": "2.1.4",
    "use-state-with-callback": "3.0.2",
    "use-sync-external-store": "1.6.0",
    "uuid": "3.3.3",
    "validator": "13.15.26",
    "vite-plugin-babel": "1.1.3",
    "vite-plugin-commonjs": "0.10.4",
    "vite-plugin-css-injected-by-js": "3.2.1",
    "vite-plugin-ejs": "1.6.4",
    "vite-plugin-inline-css-modules": "0.0.7",
    "vite-plugin-ssr": "0.4.85",
    "vite-plugin-style-import": "2.0.0"
  },
  "devDependencies": {
    "autoprefixer": "10.4.27",
    "css-loader": "^6.11.0",
    "cssnano": "7.1.3",
    "file-loader": "^6.2.0",
    "history": "4.9.0",
    "postcss-loader": "^7.3.4",
    "prop-types": "15.7.2",
    "redux-immutable-state-invariant": "2.1.0",
    "sass-loader": "^13.3.3",
    "style-loader": "^3.3.4",
    "url-loader": "^4.1.1",
    "vite": "4.5.14",
    "vite-plugin-esmodule": "1.5.0",
    "vite-plugin-html": "3.2.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": ""
  },
  "jest": {
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/tools/assetsTransformer.js",
      "\\.(css)$": "<rootDir>/tools/assetsTransformer.js"
    },
    "setupFiles": [
      "raf/polyfill",
      "./tools/enzymeTestAdapterSetup.js"
    ]
  },
  "babel": {
    "env": {
      "development": {
        "compact": false,
        "presets": [
          [
            "@babel/preset-env",
            {
              "modules": false
            }
          ],
          "@babel/preset-react"
        ],
        "plugins": [
          [
            "transform-react-remove-prop-types",
            {
              "removeImport": true
            }
          ],
          "@babel/plugin-syntax-dynamic-import",
          "@babel/plugin-proposal-class-properties",
          [
            "import",
            {
              "libraryName": "antd",
              "style": false
            }
          ],
          [
            "transform-imports",
            {
              "lodash": {
                "transform": "lodash/${member}",
                "preventFullImport": true
              }
            }
          ]
        ]
      },
      "production": {
        "compact": false,
        "presets": [
          [
            "@babel/preset-env",
            {
              "modules": false
            }
          ],
          "@babel/preset-react"
        ],
        "plugins": [
          [
            "transform-react-remove-prop-types",
            {
              "removeImport": true
            }
          ],
          "@babel/plugin-proposal-class-properties",
          "@babel/plugin-syntax-dynamic-import",
          [
            "import",
            {
              "libraryName": "antd",
              "style": false
            }
          ],
          [
            "transform-imports",
            {
              "lodash": {
                "transform": "lodash/${member}",
                "preventFullImport": true
              }
            }
          ]
        ]
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "eslint:recommended",
      "plugin:import/errors",
      "plugin:import/warnings",
      "plugin:react/recommended"
    ],
    "plugins": [
      "react"
    ],
    "parser": "babel-eslint",
    "parserOptions": {
      "ecmaVersion": 6,
      "sourceType": "script",
      "ecmaFeatures": {
        "jsx": true,
        "experimentalObjectRestSpread": true
      }
    },
    "env": {
      "es6": true,
      "browser": true,
      "node": true,
      "jquery": true,
      "jest": true
    },
    "globals": {}
  }
}
